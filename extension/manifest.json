{
  "manifest_version": 3,
  "name": "CyberOto AI",
  "version": "0.1.0",
  "description": "CyberGene · Araç ilanını ekspertiz öncesi eler: kusur röntgeni, piyasa kıyası, teklif. Karar destek aracıdır, ekspertiz değildir.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://otoxray.cybergene.co/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "CyberOto AI",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.sahibinden.com/ilan/*"
      ],
      "js": [
        "lib/selectors.js",
        "lib/privacy.js",
        "lib/extract-detail.js",
        "lib/highlight.js",
        "content/detail.js"
      ],
      "css": [
        "content/detail.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.sahibinden.com/*"
      ],
      "exclude_matches": [
        "*://*.sahibinden.com/ilan/*"
      ],
      "js": [
        "lib/selectors.js",
        "lib/privacy.js",
        "lib/legal.js",
        "lib/extract-search.js",
        "content/search.js"
      ],
      "css": [
        "content/search.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://cybergene.co",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/cg.svg",
        "fonts/inter-latin.woff2",
        "fonts/inter-latin-ext.woff2",
        "fonts/space-grotesk-latin.woff2",
        "fonts/space-grotesk-latin-ext.woff2"
      ],
      "matches": [
        "*://*.sahibinden.com/*"
      ]
    }
  ]
}
