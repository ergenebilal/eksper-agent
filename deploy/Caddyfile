# otoXray API — otomatik HTTPS (Let's Encrypt). ALAN_ADINIZ yerine kendi alt alan adınızı yazın (ör. api.ornek.com).
ALAN_ADINIZ {
	encode gzip
	# Yalnız API ve sağlık kontrolü dışarı açılır; panel (8990) ASLA buradan yayınlanmaz.
	@api path /api/v1/* /healthz
	handle @api {
		reverse_proxy 127.0.0.1:8991
	}
	handle {
		respond 404
	}
	log {
		output discard          # erişim günlüğü tutulmaz (ilan no / IP birikmesin)
	}
}
