# /opt/otoxray/.env — yalnız CyberOto API'si için gerekenler (toplayıcı/panel/Telegram ayarları sunucuda YOK)
EXTENSION_TOKEN=          # SAHİP anahtarı: en az 32 rastgele karakter, kimseyle paylaşma
XRAY_HOST=127.0.0.1       # Caddy aynı makinede; doğrudan dışarı açma
XRAY_PORT=8991
XRAY_FORWARDED_ALLOW_IPS=127.0.0.1
PANEL_ALLOWED_HOSTS=["cyberoto.cybergene.co","otoxray.cybergene.co","127.0.0.1","localhost"]   # eski ad geçiş dönemi için
PUBLIC_URL=https://cyberoto.cybergene.co   # e-posta logosu/bağlantıları

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
XRAY_SECOND_PASS=hard

ANALYZE_DAILY_LIMIT=300   # sunucunun toplam günlük LLM sınırı (maliyet tavanı)
USER_DAILY_QUOTA=30       # davetli başına günlük analiz
USER_DAILY_BATCH=400      # davetli başına günlük arama sayfası rozeti / ön hesap
FEEDBACK_DAILY_LIMIT=50

# E-posta koduyla giriş + davet (zorunlu: yoksa kod gönderilemez, açıkça hata verir)
SMTP_HOST=                # ör. smtp.gmail.com (Google Workspace) ya da sağlayıcınızın SMTP'si
SMTP_PORT=587             # 587 = STARTTLS, 465 = SSL
SMTP_USER=                # ör. otoxray@cybergene.co
SMTP_PASSWORD=            # Google için "uygulama şifresi"
SMTP_FROM=                # gönderen adres, ör. otoxray@cybergene.co
STORE_URL=                # davet e-postasındaki Chrome Web Store bağlantısı (yayınlanınca)

# Yönetim sayfası https://cyberoto.cybergene.co/yonetim : yalnız bu adreslere giriş kodu gider
ADMIN_EMAILS=["yonetici@cybergene.co"]
ADMIN_COOKIE_SECURE=true
