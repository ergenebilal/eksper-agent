# /opt/otoxray/.env — yalnız otoXray API'si için gerekenler (toplayıcı/panel/Telegram ayarları sunucuda YOK)
EXTENSION_TOKEN=          # SAHİP anahtarı: en az 32 rastgele karakter, kimseyle paylaşma
XRAY_HOST=127.0.0.1       # Caddy aynı makinede; doğrudan dışarı açma
XRAY_PORT=8991
XRAY_FORWARDED_ALLOW_IPS=127.0.0.1
PANEL_ALLOWED_HOSTS=["ALAN_ADINIZ","127.0.0.1","localhost"]

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
XRAY_SECOND_PASS=hard

ANALYZE_DAILY_LIMIT=300   # sunucunun toplam günlük LLM sınırı (maliyet tavanı)
USER_DAILY_QUOTA=30       # davetli başına günlük analiz
USER_DAILY_BATCH=400      # davetli başına günlük arama sayfası rozeti / ön hesap
FEEDBACK_DAILY_LIMIT=50
