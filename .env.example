# LLM havuzu (OpenAI-uyumlu uç nokta). Değerleri Antigravity havuz yapılandırmasından al.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_STRONG=

# Bildirim: arac = Telegram'a kendisi gönderir | jeff = yalnızca events tablosuna yazar (Jeff okur) | off
NOTIFY_MODE=arac
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Zamanlama: internal = `arac watch run` sürekli çalışır | external = cron/Jeff `arac watch run --once` tetikler
SCHEDULER_MODE=internal

# Toplama güvenliği (kod seviyesinde zorunlu alt sınırlar vardır; bunlar yalnızca sıkılaştırmak içindir)
MAX_PAGES_PER_HOUR=40

# Panel (arac panel serve): token boşsa/16 karakterden kısaysa panel BAŞLAMAZ
PANEL_TOKEN=
PANEL_HOST=127.0.0.1
PANEL_PORT=8990
